# Managed PostgreSQL connection used by Prisma at runtime.
# Use the provider's pooled/runtime connection for DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&schema=public"

# Direct provider connection used for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&schema=public"

# Never commit real credentials. Configure these values in Vercel Preview and Production settings.
